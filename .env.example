# Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=            # через запятую, три партнёра
ADMIN_TELEGRAM_IDS=              # через запятую, кто подтверждает удаление DNG

# Google Drive через rclone (remote настраивается командой rclone config на сервере)
RCLONE_REMOTE=motorhof
DRIVE_ROOT=MOTORHOF_AUTO
SOURCE_SUBDIR=Фотографии
OUTPUT_SUBDIR=На выгрузку

# Worker
TMP_DIR=/app/data/tmp
DB_PATH=/app/data/motorhof.sqlite
LOG_LEVEL=INFO
QUEUE_LIMIT=10                   # сколько задач может ждать в очереди

# Расписание
TZ=Europe/Vienna
DAILY_CHECK_TIME=03:00           # ежедневная проверка, ЧЧ:ММ по TZ
DNG_REMINDER_DAYS=60             # через сколько дней спросить про удаление DNG
