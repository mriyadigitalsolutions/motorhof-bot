# Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=            # через запятую, три партнёра

# Google Drive через rclone (remote настраивается командой rclone config на сервере)
RCLONE_REMOTE=motorhof
DRIVE_ROOT=MOTORHOF_AUTO
SOURCE_SUBDIR=Фотографии
OUTPUT_SUBDIR=На выгрузку

# Worker
TMP_DIR=/app/data/tmp
DB_PATH=/app/data/motorhof.sqlite
LOG_LEVEL=INFO
