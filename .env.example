# Настройки motorhof-bot. Скопируй: cp .env.example .env — и впиши значения в .env.
# .env в git не попадает. Комментарии — только отдельной строкой, не после значения.

# --- Telegram (вписать самому) ---
# Токен бота от @BotFather (бот создаётся с аккаунта OG).
TELEGRAM_BOT_TOKEN=
# Telegram-ID партнёров через запятую, без пробелов: 111111111,222222222,333333333 (узнать у @userinfobot).
# Пусто или ошибка в любом ID — бот не отвечает никому.
ALLOWED_TELEGRAM_IDS=
# ID администратора (через запятую, если их несколько). Подтверждает удаление DNG.
# Должен быть и в ALLOWED_TELEGRAM_IDS. Пусто — удалять DNG нельзя.
ADMIN_TELEGRAM_IDS=

# --- Google Drive через rclone ---
# Имя remote из rclone.conf (настраивается командой rclone config на сервере).
RCLONE_REMOTE=motorhof
# Корневая папка на общем диске, внутри неё MH_AUTO_НАЛИЧИЕ, MH_AUTO_ПРОДАНО, KO_AUTO_НАЛИЧИЕ, KO_AUTO_ПРОДАНО.
DRIVE_ROOT=MOTORHOF_AUTO
# Папка с исходниками внутри папки машины.
SOURCE_SUBDIR=Фотографии
# Папка для готовых JPEG внутри SOURCE_SUBDIR (переход на Online — поменять здесь).
OUTPUT_SUBDIR=На выгрузку

# --- Работа сервиса ---
# Пути внутри контейнера; /app/data — это папка ./data на сервере (volume в docker-compose.yml).
TMP_DIR=/app/data/tmp
DB_PATH=/app/data/motorhof.sqlite
# Уровень логов: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Сколько задач может ждать в очереди.
QUEUE_LIMIT=10

# --- Расписание ---
# Часовой пояс для расписания и времени в /last.
TZ=Europe/Vienna
# Время ежедневной проверки, ЧЧ:ММ по TZ.
DAILY_CHECK_TIME=03:00
# Через сколько дней после первой конвертации спросить про удаление DNG.
DNG_REMINDER_DAYS=60
